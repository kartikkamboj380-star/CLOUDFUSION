# Copy to .env and replace every placeholder. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://cloudfusion:replace-with-a-strong-password@db:5432/cloudfusion
POSTGRES_USER=cloudfusion
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=cloudfusion
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-generated-fernet-key
# Web application OAuth credentials (not an Android client secret).
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
# Must exactly match an authorized Google redirect URI; use HTTPS outside local development.
GOOGLE_REDIRECT_URI=https://your-domain.example/api/oauth/callback
# Comma-separated HTTPS origins; leave empty when the frontend is served from the API origin.
CORS_ORIGINS=
# TOKEN_ENCRYPTION_KEY is an optional alias for FERNET_KEY, not a second key.
# Keep using the SAME existing FERNET_KEY to preserve stored credentials.
# Remote downloads require one backend process and a public-egress firewall.
# No APP_BASE_URL variable is consumed: GOOGLE_REDIRECT_URI is the exact callback.
